---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="about-page">

		<!-- HERO -->
		<section class="about-hero">
			<img
				class="hero-background"
				src="/about-hero.jpg"
				alt=""
			/>

			<div class="hero-overlay"></div>

			<div class="hero-content">
				<p class="eyebrow">O 10DEVET</p>

				<h1>
					VIŠE OD<br />
					<span>FUDBALA.</span>
				</h1>

				<p class="hero-tagline">PRIČE KOJE OSTAJU.</p>

				<p class="hero-description">
					10devet je mesto gde fudbal dobija dublji smisao.
					Kroz dokumentarce, priče i ljude koji su obeležili igru,
					pričamo fudbal drugačije.
				</p>

				<div class="hero-line"></div>

				<p class="hero-slogan">
					FUDBAL ISPRIČAN DRUGAČIJE.
				</p>
			</div>

			<div class="pillars">
				<div class="pillar">
					<p class="pillar-number">01</p>
					<div>
						<h2>DOKUMENTARCI</h2>
						<p>
							Dublje priče o ljudima koji su oblikovali fudbal.
						</p>
					</div>
				</div>

				<div class="pillar">
					<p class="pillar-number">02</p>
					<div>
						<h2>PRIČE</h2>
						<p>
							Zaboravljeni momenti, velike legende i
							neispričane priče.
						</p>
					</div>
				</div>

				<div class="pillar">
					<p class="pillar-number">03</p>
					<div>
						<h2>ZA ZAJEDNICU</h2>
						<p>
							Fudbal je više od igre — to je naša zajednička priča.
						</p>
					</div>
				</div>
			</div>
		</section>


		<!-- WHY -->
<section class="why-section">
	<div class="why-top">
		<span class="section-number">01</span>
		<p class="section-label">ZAŠTO 10DEVET?</p>
	</div>

	<div class="why-grid">
		<div class="section-heading">
			<h2>
				VEST TRAJE<br />
				JEDAN DAN.
			</h2>

			<h3>
				DOBRA PRIČA<br />
				OSTANE.
			</h3>
		</div>

		<div class="section-text">
			<p class="lead">
				Fudbal svakog dana donosi nove rezultate, transfere,
				izjave i vesti.
			</p>

			<p>
				Ali iza svega toga postoje priče koje zaslužuju više
				od nekoliko rečenica.
			</p>

			<p>
				<strong>10devet je nastao upravo zbog njih.</strong>
			</p>

			<p>
				Želimo da kroz video i dokumentarni pristup istražujemo
				ljude, klubove, rivalstva, trenutke i događaje koji
				fudbal čine onim što jeste.
			</p>

			<p>
				Ne želimo samo da kažemo <em>šta se dogodilo.</em>
				Želimo da saznamo <em>zašto se dogodilo, ko je iza toga
				i zašto je važno.</em>
			</p>
		</div>
	</div>
</section>


		<!-- MISSION -->
<section class="mission-section">
	<div class="mission-inner">

		<div class="mission-top">
			<span class="section-number">02</span>
			<p class="section-label">ŠTA ŽELIMO?</p>
		</div>

		<h2>
			FUDBAL,<br />
			<span>SA DRUGAČIJIM</span><br />
			UGLOM.
		</h2>

		<div class="mission-bottom">
			<div class="mission-statement">
				<p>
					Naš cilj nije da budemo još jedan fudbalski portal.
				</p>
			</div>

			<div class="mission-copy">
				<p class="lead">
					Naš glavni proizvod je video.
				</p>

				<p>
					Dokumentarci, kratke priče i originalni formati koji
					kombinuju istraživanje, video produkciju, motion design
					i storytelling.
				</p>

				<p>
					Od velikih fudbalskih priča do onih koje su prošle
					gotovo neprimećeno.
				</p>
			</div>
		</div>

	</div>
</section>


		<!-- CREATOR -->
		<!-- CREATOR -->
<section class="creator-section">
	<div class="creator-top">
		<span class="section-number">03</span>
		<p class="section-label">KO STOJI IZA 10DEVET?</p>
	</div>

	<div class="creator-heading">
		<h2>
			JEDNA IDEJA.
			<span>JEDAN KREATIVNI PROJEKAT.</span>
		</h2>
	</div>

	<div class="creator-bottom">
		<div class="creator-statement">
			<p>
				10devet je nastao iz ljubavi prema fudbalu
				i želje da se priče pričaju drugačije.
			</p>
		</div>

		<div class="creator-content">
			<p class="creator-lead">
				10devet je pokrenuo Aleksandar Živković,
				kreator sa iskustvom u digitalnom marketingu,
				video produkciji, motion designu i vizuelnom
				storytellingu.
			</p>

			<p>
				Ljubav prema fudbalu spojila se sa onim što najbolje
				poznaje, pričanjem priča kroz sliku, zvuk i pokret.
			</p>

			<p>
				Ideja je jednostavna:
				<strong>napraviti mesto gde fudbal može da se
				ispriča drugačije.</strong>
			</p>

			<p>
				Ne samo kroz ono što se vidi na terenu, već i kroz
				ljude, okolnosti i priče koje postoje iza njega.
			</p>
		</div>
	</div>

	<div class="creator-mark">
		10<span>DEVET</span>
	</div>
</section>


		<!-- WHAT WE DO -->
<section class="work-section">
	<div class="work-header">
		<div>
			<div class="work-number">04</div>
			<p class="section-label">ŠTA RADIMO?</p>

			<h2>
				NAŠ<br />
				<span>FORMAT.</span>
			</h2>
		</div>

		<p class="work-intro">
			Video je srce 10devet-a.
			Sve što radimo počinje pričom.
		</p>
	</div>

	<div class="work-list">

		<article class="work-item">
			<div class="work-item-number">01</div>

			<div class="work-item-main">
				<h3>DOKUMENTARCI</h3>
				<p>
					Dublje fudbalske priče koje zahtevaju istraživanje,
					vreme i produkciju.
				</p>
			</div>

			<div class="work-arrow">↗</div>
		</article>

		<article class="work-item">
			<div class="work-item-number">02</div>

			<div class="work-item-main">
				<h3>PRIČE</h3>
				<p>
					Kratki formati o zanimljivim ljudima, događajima
					i momentima koji zaslužuju da budu ispričani.
				</p>
			</div>

			<div class="work-arrow">↗</div>
		</article>

		<article class="work-item">
			<div class="work-item-number">03</div>

			<div class="work-item-main">
				<h3>VIDEO PRODUKCIJA</h3>
				<p>
					Montaža, motion design, vizuelni storytelling
					i originalna produkcija.
				</p>
			</div>

			<div class="work-arrow">↗</div>
		</article>

		<article class="work-item">
			<div class="work-item-number">04</div>

			<div class="work-item-main">
				<h3>ZAJEDNICA</h3>
				<p>
					Ljudi, klubovi i priče koje povezuju fudbalske
					generacije.
				</p>
			</div>

			<div class="work-arrow">↗</div>
		</article>

	</div>
</section>


		<!-- CTA -->
<section class="about-cta">
	<div class="cta-content">
		<p class="section-label">10DEVET</p>

		<h2>
			FUDBAL SE<br />
			NE ZAVRŠAVA<br />
			<span>NA TERENU.</span>
		</h2>

		<p class="cta-subtitle">
			Priča se nastavlja.
		</p>
	</div>

	<a href="/najnovije-price" class="cta-link">
		POGLEDAJ PRIČE <span>→</span>
	</a>
</section>

	</main>
</Layout>

<style>
	.about-page {
		background: var(--black);
	}

	/* GLOBAL */

	.section-label {
		margin: 0 0 25px;
		color: var(--red);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	/* HERO */

	.about-hero {
		position: relative;
		width: 100%;
		min-height: 100vh;
		height: 100vh;
		overflow: hidden;
		display: flex;
		align-items: center;
		margin: 0;
		padding: 0;
	}

	.hero-background {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 42% center;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				90deg,
				rgba(8, 8, 8, 0.98) 0%,
				rgba(8, 8, 8, 0.88) 32%,
				rgba(8, 8, 8, 0.45) 58%,
				rgba(8, 8, 8, 0.18) 100%
			);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: min(620px, 42%);
		margin-left: 6.7vw;
		margin-top: -70px;
	}

	.eyebrow {
		margin: 0 0 20px;
		color: var(--red);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.hero-content h1 {
		margin: 0;
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(80px, 9vw, 150px);
		font-weight: 400;
		line-height: 0.82;
	}

	.hero-content h1 span {
		color: var(--red);
	}

	.hero-tagline {
		margin: 28px 0 0;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.hero-description {
		max-width: 570px;
		margin: 28px 0 0;
		color: rgba(224, 214, 205, 0.82);
		font-size: 17px;
		line-height: 1.65;
	}

	.hero-line {
		width: 42px;
		height: 3px;
		margin-top: 28px;
		background: var(--red);
	}

	.hero-slogan {
		margin: 14px 0 0;
		color: rgba(224, 214, 205, 0.65);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.2em;
	}

	.pillars {
		position: absolute;
		z-index: 3;
		left: 6.7vw;
		right: 6.7vw;
		bottom: 42px;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
	}

	.pillar {
		display: flex;
		gap: 18px;
		padding: 0 38px;
		border-right: 1px solid rgba(224, 214, 205, 0.22);
	}

	.pillar:first-child {
		padding-left: 0;
	}

	.pillar:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.pillar-number {
		margin: 0;
		color: var(--red);
		font-family: 'Bebas Neue', sans-serif;
		font-size: 30px;
		line-height: 1;
	}

	.pillar h2 {
		margin: 0 0 8px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.pillar p {
		max-width: 260px;
		margin: 0;
		color: rgba(224, 214, 205, 0.65);
		font-size: 14px;
		line-height: 1.55;
	}

	/* WHY */

.why-section {
	padding: 150px 6.7vw 170px;
	background: var(--black);
	border-top: 1px solid rgba(224, 214, 205, 0.1);
}

.why-top {
	display: flex;
	align-items: center;
	gap: 28px;
	margin-bottom: 85px;
}

.section-number {
	color: var(--red);
	font-family: 'Bebas Neue', sans-serif;
	font-size: 28px;
	line-height: 1;
}

.why-top .section-label {
	margin: 0;
}

.why-grid {
	display: grid;
	grid-template-columns: 1.15fr 0.85fr;
	gap: 10vw;
	align-items: end;
}

.section-heading h2,
.section-heading h3 {
	margin: 0;
	font-family: 'Bebas Neue', sans-serif;
	font-size: clamp(70px, 8vw, 130px);
	font-weight: 400;
	line-height: 0.82;
}

.section-heading h3 {
	margin-top: 20px;
	color: var(--red);
}

.section-text {
	max-width: 580px;
}

.section-text p {
	margin: 0 0 28px;
	color: rgba(224, 214, 205, 0.7);
	font-size: 18px;
	line-height: 1.7;
}

.section-text .lead {
	color: var(--off-white);
	font-size: 22px;
	line-height: 1.5;
}

.section-text strong {
	color: var(--off-white);
}

.section-text em {
	color: var(--off-white);
	font-style: normal;
}

	/* MISSION */

.mission-section {
	padding: 120px 6.7vw 140px;
	background: var(--red);
	color: var(--black);
}

.mission-inner {
	max-width: 1500px;
	margin: 0 auto;
}

.mission-top {
	display: flex;
	align-items: center;
	gap: 28px;
	margin-bottom: 70px;
}

.mission-section .section-number {
	color: var(--black);
}

.mission-section .section-label {
	margin: 0;
	color: var(--black);
}

.mission-section h2 {
	margin: 0;
	max-width: 1100px;
	font-family: 'Bebas Neue', sans-serif;
	font-size: clamp(80px, 11vw, 180px);
	font-weight: 400;
	line-height: 0.78;
}

.mission-section h2 span {
	color: var(--off-white);
}

.mission-bottom {
	display: grid;
	grid-template-columns: 1fr 0.8fr;
	gap: 10vw;
	margin-top: 100px;
	align-items: end;
}

.mission-statement {
	max-width: 650px;
}

.mission-statement p {
	margin: 0;
	font-family: 'Bebas Neue', sans-serif;
	font-size: clamp(38px, 4vw, 62px);
	line-height: 0.95;
}

.mission-copy {
	max-width: 560px;
}

.mission-copy p {
	margin: 0 0 28px;
	color: rgba(8, 8, 8, 0.72);
	font-size: 17px;
	line-height: 1.7;
}

.mission-copy .lead {
	color: var(--black);
	font-size: 24px;
	font-weight: 700;
	line-height: 1.4;
}

@media (max-width: 800px) {
	.mission-section {
		padding: 90px 5vw;
	}

	.mission-top {
		margin-bottom: 55px;
	}

	.mission-section h2 {
		font-size: clamp(70px, 18vw, 115px);
	}

	.mission-bottom {
		grid-template-columns: 1fr;
		gap: 55px;
		margin-top: 70px;
	}

	.mission-statement p {
		font-size: 42px;
	}

	.mission-copy p {
		font-size: 16px;
	}

	.mission-copy .lead {
		font-size: 20px;
	}
}

	/* CREATOR */

.creator-section {
	position: relative;
	padding: 150px 6.7vw 130px;
	background: var(--black);
	overflow: hidden;
}

.creator-top {
	display: flex;
	align-items: center;
	gap: 28px;
	margin-bottom: 75px;
}

.creator-top .section-label {
	margin: 0;
}

.creator-heading {
	max-width: 1250px;
}

.creator-heading h2 {
	margin: 0;
	font-family: 'Bebas Neue', sans-serif;
	font-size: clamp(80px, 11vw, 180px);
	font-weight: 400;
	line-height: 0.78;
}

.creator-heading h2 span {
	display: block;
	color: var(--red);
}

.creator-bottom {
	display: grid;
	grid-template-columns: 1fr 0.8fr;
	gap: 10vw;
	margin-top: 100px;
	align-items: end;
}

.creator-statement {
	max-width: 700px;
}

.creator-statement p {
	margin: 0;
	font-family: 'Bebas Neue', sans-serif;
	font-size: clamp(42px, 4.5vw, 70px);
	line-height: 0.92;
}

.creator-content {
	max-width: 580px;
}

.creator-content p {
	margin: 0 0 28px;
	color: rgba(224, 214, 205, 0.68);
	font-size: 17px;
	line-height: 1.7;
}

.creator-content .creator-lead {
	color: var(--off-white);
	font-size: 22px;
	line-height: 1.5;
}

.creator-content strong {
	color: var(--off-white);
}

.creator-mark {
	margin-top: 130px;
	color: rgba(224, 214, 205, 0.045);
	font-family: 'Bebas Neue', sans-serif;
	font-size: clamp(150px, 25vw, 420px);
	line-height: 0.65;
	letter-spacing: -0.03em;
}

.creator-mark span {
	color: var(--red);
}

/* MOBILE */

@media (max-width: 800px) {
	.creator-section {
		padding: 90px 5vw;
	}

	.creator-top {
		margin-bottom: 55px;
	}

	.creator-heading h2 {
		font-size: clamp(70px, 18vw, 115px);
	}

	.creator-bottom {
		grid-template-columns: 1fr;
		gap: 55px;
		margin-top: 70px;
	}

	.creator-statement p {
		font-size: 42px;
	}

	.creator-content p {
		font-size: 16px;
	}

	.creator-content .creator-lead {
		font-size: 19px;
	}

	.creator-mark {
		margin-top: 90px;
		font-size: 150px;
	}
}

	/* WORK */

.work-section {
	padding: 150px 6.7vw;
	background: var(--black);
	border-top: 1px solid rgba(224, 214, 205, 0.1);
}

.work-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	gap: 60px;
	margin-bottom: 100px;
}

.work-number {
	margin-bottom: 25px;
	color: var(--red);
	font-family: 'Bebas Neue', sans-serif;
	font-size: 28px;
}

.work-header h2 {
	margin: 0;
	font-family: 'Bebas Neue', sans-serif;
	font-size: clamp(90px, 11vw, 180px);
	font-weight: 400;
	line-height: 0.76;
}

.work-header h2 span {
	color: var(--red);
}

.work-intro {
	max-width: 360px;
	margin: 0 0 5px;
	color: rgba(224, 214, 205, 0.65);
	font-size: 17px;
	line-height: 1.6;
}

.work-list {
	border-top: 1px solid rgba(224, 214, 205, 0.18);
}

.work-item {
	display: grid;
	grid-template-columns: 80px 1fr 60px;
	gap: 40px;
	align-items: center;
	padding: 42px 0;
	border-bottom: 1px solid rgba(224, 214, 205, 0.18);
	transition: padding 0.3s ease;
}

.work-item:hover {
	padding-left: 18px;
	padding-right: 18px;
	background: rgba(147, 15, 24, 0.06);
}

.work-item-number {
	color: var(--red);
	font-family: 'Bebas Neue', sans-serif;
	font-size: 26px;
}

.work-item-main {
	display: grid;
	grid-template-columns: minmax(260px, 0.7fr) 1fr;
	gap: 60px;
	align-items: center;
}

.work-item-main h3 {
	margin: 0;
	font-size: 19px;
	font-weight: 700;
	letter-spacing: 0.12em;
}

.work-item-main p {
	max-width: 480px;
	margin: 0;
	color: rgba(224, 214, 205, 0.62);
	font-size: 15px;
	line-height: 1.6;
}

.work-arrow {
	color: var(--red);
	font-size: 24px;
	text-align: right;
	transition: transform 0.3s ease;
}

.work-item:hover .work-arrow {
	transform: translate(5px, -5px);
}

@media (max-width: 800px) {
	.work-section {
		padding: 90px 5vw;
	}

	.work-header {
		display: block;
		margin-bottom: 60px;
	}

	.work-header h2 {
		font-size: clamp(75px, 19vw, 120px);
	}

	.work-intro {
		margin-top: 35px;
	}

	.work-item {
		grid-template-columns: 40px 1fr 30px;
		gap: 15px;
		padding: 30px 0;
	}

	.work-item:hover {
		padding-left: 0;
		padding-right: 0;
		background: transparent;
	}

	.work-item-main {
		display: block;
	}

	.work-item-main h3 {
		font-size: 15px;
	}

	.work-item-main p {
		margin-top: 12px;
		font-size: 14px;
	}

	.work-arrow {
		font-size: 20px;
	}
}

	/* CTA */

.about-cta {
	position: relative;
	min-height: 620px;
	padding: 120px 6.7vw;
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 60px;
	background: var(--red);
	overflow: hidden;
}

.about-cta::after {
	content: '10';
	position: absolute;
	right: -20px;
	bottom: -100px;
	color: rgba(8, 8, 8, 0.08);
	font-family: 'Bebas Neue', sans-serif;
	font-size: 500px;
	line-height: 0.7;
	pointer-events: none;
}

.cta-content {
	position: relative;
	z-index: 1;
}

.about-cta .section-label {
