---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="contact-page">

		<section class="contact-hero">
			<p class="eyebrow">10DEVET · KONTAKT</p>
			<h1>HAJDE DA<br />RAZGOVARAMO.</h1>
			<p class="intro">
				Imaš priču, ideju, projekat ili želiš da sarađujemo?
				Javi nam se.
			</p>
		</section>

		<section class="contact-info">
			<div class="contact-label">
				<span>10DEVET</span>
				<span>KONTAKT</span>
			</div>

			<div class="contact-details">
				<a href="mailto:info@10devet.com">info@10devet.com</a>
				<a href="mailto:media@10devet.com">media@10devet.com</a>
			</div>
		</section>

	</main>
</Layout>

<style>
	.contact-page {
		background: var(--black);
		padding-top: 82px;
	}

	.contact-hero {
		width: min(1200px, 86vw);
		margin: 0 auto;
		padding: 120px 0 110px;
	}

	.eyebrow {
		margin: 0 0 25px;
		color: var(--red);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	h1 {
		margin: 0;
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(80px, 11vw, 160px);
		font-weight: 400;
		line-height: 0.82;
	}

	.intro {
		max-width: 620px;
		margin: 45px 0 0;
		color: rgba(224, 214, 205, 0.65);
		font-size: 18px;
		line-height: 1.7;
	}

	.contact-info {
		width: min(1200px, 86vw);
		margin: 0 auto;
		padding: 80px 70px 90px;
		display: grid;
		grid-template-columns: 0.45fr 1fr;
		gap: 70px;
		background: var(--red);
		color: var(--black);
	}

	.contact-label {
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.contact-details {
		display: flex;
		flex-direction: column;
		gap: 25px;
	}

	.contact-details a {
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(40px, 5vw, 70px);
		line-height: 0.9;
		transition: opacity 0.2s ease;
	}

	.contact-details a:hover {
		opacity: 0.65;
	}

	@media (max-width: 800px) {
		.contact-hero {
			padding: 80px 0;
		}

		.contact-info {
			width: 100%;
			padding: 70px 5vw 80px;
			grid-template-columns: 1fr;
			gap: 35px;
		}

		.contact-details a {
			font-size: 42px;
		}
	}
</style>