<header class="site-header">
	<a href="/" class="logo">
		<img src="/logo.png" alt="10devet" />
	</a>

	<nav class="desktop-nav" aria-label="Glavna navigacija">
		
		<a href="/najnovije-price">NAJNOVIJE VIDEO PRIČE</a>
		<a href="/o-nama">O NAMA</a>
		<a href="/kontakt">KONTAKT</a>
	</nav>

	<button class="menu-button" aria-label="Otvori meni">
		<span></span>
		<span></span>
	</button>
</header>

<style>
	.site-header {
	position: fixed;
	top: 0;
	left: 0;
	z-index: 100;
	width: 100%;
	height: 82px;
	padding: 16px 5vw;

	display: flex;
	align-items: center;
	justify-content: space-between;

	background: rgba(8, 8, 8, 0.6);
	backdrop-filter: blur(14px);
	-webkit-backdrop-filter: blur(14px);

	border-bottom: 1px solid rgba(224, 214, 205, 0.12);
}

.logo {
	display: block;
	width: 72px;
	flex-shrink: 0;
}

.logo img {
	display: block;
	width: 72px !important;
	height: auto !important;
	max-width: 72px;
}

	.desktop-nav {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);

	display: flex;
	align-items: center;
	gap: 28px;
}

	.desktop-nav a {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		transition: color 0.2s ease;
	}

	.desktop-nav a:hover {
		color: var(--red);
	}

	.menu-button {
		display: none;
		background: none;
		border: 0;
		padding: 8px;
		cursor: pointer;
	}

	.menu-button span {
		display: block;
		width: 26px;
		height: 2px;
		margin: 6px 0;
		background: var(--off-white);
	}
	.menu-button.active span:first-child {
	transform: translateY(4px) rotate(45deg);
}

.menu-button.active span:last-child {
	transform: translateY(-4px) rotate(-45deg);
}

	@media (max-width: 800px) {
	.site-header {
		padding: 20px 5vw;
	}

	.desktop-nav {
		display: none;
	}

	.menu-button {
		display: block;
	}

	.desktop-nav.mobile-open {
		position: absolute;
		top: 82px;
		left: 0;
		width: 100%;

		padding: 30px 5vw;

		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;

		transform: none;

		background: rgba(8, 8, 8, 0.96);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);

		border-bottom: 1px solid rgba(224, 214, 205, 0.12);
	}

	.desktop-nav.mobile-open a {
		font-size: 12px;
	}
}

		.desktop-nav.mobile-open {
	position: absolute;
	top: 82px;
	left: 0;
	width: 100%;
	padding: 30px 5vw;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 22px;
	background: rgba(8, 8, 8, 0.96);
	backdrop-filter: blur(14px);
	-webkit-backdrop-filter: blur(14px);
	border-bottom: 1px solid rgba(224, 214, 205, 0.12);
}
	}
</style>
<script>
	const menuButton = document.querySelector('.menu-button');
	const desktopNav = document.querySelector('.desktop-nav');

	menuButton?.addEventListener('click', () => {
	desktopNav?.classList.toggle('mobile-open');
	menuButton?.classList.toggle('active');
});

	desktopNav?.querySelectorAll('a').forEach((link) => {
	link.addEventListener('click', () => {
		desktopNav.classList.remove('mobile-open');
	});
});
</script>