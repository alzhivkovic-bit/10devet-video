---
import { getCollection } from 'astro:content';
import { getYoutubeThumbnail } from '../utils/youtube';

const stories = (await getCollection('price'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---
<section class="latest-stories">
	<div class="section-header">
		<div>
			<p class="eyebrow">10DEVET · STORIES</p>
			<h2>NAJNOVIJE PRIČE</h2>
		</div>

		<a href="/najnovije-price" class="view-all">
			SVE PRIČE <span>→</span>
		</a>
	</div>

	<div class="stories-grid">
	{stories.map((story, index) => (
		<a href={`/najnovije-price/${story.id}`} class="story-card">
			<div class="story-image">
				<img
					src={getYoutubeThumbnail(story.data.youtube, story.data.thumbnail)}
					alt={story.data.title}
				/>
			</div>

			<div class="story-info">
				<p>{String(index + 1).padStart(2, '0')} · PRIČA</p>
				<h3>{story.data.title}</h3>
			</div>
		</a>
	))}
</div>

</section>

<style>
	.latest-stories {
		padding: 120px 5vw;
		background: #0c0c0c;
	}

	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 40px;
	}

	.eyebrow {
		margin: 0 0 14px;
		color: var(--red);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	h2 {
		margin: 0;
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(42px, 5vw, 72px);
		font-weight: 400;
		line-height: 0.9;
	}

	.view-all {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding-bottom: 8px;
		border-bottom: 1px solid var(--red);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		transition: gap 0.25s ease;
	}

	.view-all:hover {
		gap: 20px;
	}

	.stories-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.story-card {
		display: block;
	}

	.story-image {
	width: 100%;
	max-width: 560px;
	aspect-ratio: 16 / 9;
	overflow: hidden;
	background: #161616;
}
.story-image img {
	width: 100%;
	height: 100%;
	display: block;
	object-fit: cover;
}

	.image-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(224, 214, 205, 0.25);
		font-size: 10px;
		letter-spacing: 0.15em;
		transition: transform 0.5s ease;
	}

	.story-card:hover .image-placeholder {
		transform: scale(1.03);
	}

	.story-info {
		padding-top: 18px;
	}

	.story-info p {
		margin: 0 0 10px;
		color: var(--red);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	h3 {
		margin: 0;
		font-family: 'Bebas Neue', sans-serif;
		font-size: 30px;
		font-weight: 400;
		line-height: 0.95;
	}

	@media (max-width: 800px) {
		.latest-stories {
			padding: 80px 5vw;
		}

		.section-header {
			align-items: flex-start;
			gap: 25px;
			flex-direction: column;
		}

		.stories-grid {
			grid-template-columns: 1fr;
			gap: 45px;
		}
	}
</style>